# SRM Toolkit: local Maven/IDE configuration and real-SMTP test template.
# This is a template, not a ready-to-run secret file. Fill every required blank.
# No existing credentials are copied here. Preserve established secrets/passwords.
# Values are shell-compatible: preserve quoting, especially for spaces/$/#/!.
# Maven/Spring Boot do NOT automatically load this file or the root .env.
#
# Suggested use, from the repository root:
#   mkdir -p "$HOME/.config/srm"
#   cp -n .env.example "$HOME/.config/srm/local.env"
#   chmod 600 "$HOME/.config/srm/local.env"
# Edit that private file, then in EACH terminal starting a backend:
#   set -a
#   source "$HOME/.config/srm/local.env"
#   set +a
#   mvn spring-boot:run
# Run Maven from the relevant backend module directory.
# Do not overwrite an existing private file. Do not place real secrets in this
# template or the currently tracked root .env. Do not commit private env files.
#
# COMPOSE LIMITATION: this file does not repair the existing Compose packaging.
# Compose still has old login variables, incomplete Biuro DB configuration and
# MAIL_USERNAME instead of MAIL_USER; it forces SMTP auth/STARTTLS off. Exported
# shell variables/.env do not automatically enter containers without mappings.
# Use Maven for this SMTP test until Compose is corrected.

# -----------------------------------------------------------------------------
# 1. Registration database -- consumed by registration-api only
# -----------------------------------------------------------------------------
# JDBC URL for the existing registration schema. This does not create a DB/user.
DB_URL='jdbc:mariadb://localhost:3306/registration_db'
# MariaDB application account with access to registration_db and its migrations.
DB_USER='registration_user'
# REQUIRED: password of that existing DB account; not an administrator login.
DB_PASSWORD=''

# -----------------------------------------------------------------------------
# 2. Biuro database -- consumed by biuro-api only
# -----------------------------------------------------------------------------
# Separate schema on the same MariaDB instance; stores Turnusy/accounts/sessions.
BIURO_DB_URL='jdbc:mariadb://localhost:3306/biuro_db'
# MariaDB application account with access to biuro_db and its migrations.
BIURO_DB_USER='biuro_user'
# REQUIRED: password of that existing DB account. May differ from DB_PASSWORD.
BIURO_DB_PASSWORD=''
# Optional provisioning-only credential: used by Compose when initializing a NEW
# MariaDB volume, not by Java services. Changing it does not reset an existing DB.
# Leave commented for an already configured MariaDB instance.
# DB_ROOT_PASSWORD=''

# -----------------------------------------------------------------------------
# 3. Biuro -> Registration management authentication -- BOTH APIs must match
# -----------------------------------------------------------------------------
# Internal HTTP Basic account protecting registration list/detail/status routes.
# This is NOT a browser account and is NOT the MariaDB account.
REGISTRATION_SERVICE_USERNAME='biuro-service'
# REQUIRED: same private service password in registration-api AND biuro-api.
REGISTRATION_SERVICE_PASSWORD=''

# -----------------------------------------------------------------------------
# 4. Registration -> Biuro catalogue authentication -- BOTH APIs must match
# -----------------------------------------------------------------------------
# Separate read-only account for internal Turnus/season catalogue lookup.
# Do not reuse the registration-management credential above.
TURNUS_LOOKUP_USERNAME='registration-turnus-reader'
# REQUIRED: same private lookup password in registration-api AND biuro-api.
TURNUS_LOOKUP_PASSWORD=''

# -----------------------------------------------------------------------------
# 5. Biuro JWT signing -- biuro-api only, NEVER frontend configuration
# -----------------------------------------------------------------------------
# REQUIRED: established private signing secret, at least 32 UTF-8 bytes.
# For a NEW installation, generate ONCE: openssl rand -hex 32
# Store the result privately and reuse it across starts. Changing it invalidates
# existing tokens. It is separate from user passwords and service credentials.
JWT_SECRET=''

# -----------------------------------------------------------------------------
# 6. First administrator -- biuro-api only, ONE-TIME setup
# -----------------------------------------------------------------------------
# Keep false after the first admin was created (including the current local DB).
# Enable only on an installation with no accounts and incomplete bootstrap.
# Existing accounts are never overwritten; this is not a password-reset mechanism.
BIURO_BOOTSTRAP_ENABLED=false
# Required ONLY when enabling first-admin setup: unique login, 3-64 ASCII letters,
# digits or . _ -, starting with a letter/digit; normalized to lowercase.
BIURO_BOOTSTRAP_USERNAME=''
# Required ONLY for first setup: displayed name, up to 150 characters.
BIURO_BOOTSTRAP_DISPLAY_NAME=''
# Required ONLY for first setup: private temporary password, at least 12 Unicode
# characters and at most 72 UTF-8 bytes. User must change it on first login.
# After success, set ENABLED=false and remove the three credential assignments.
BIURO_BOOTSTRAP_PASSWORD=''
# Normal users/passwords/roles are managed in Biuro, not environment variables.
# BIURO_USERNAME and BIURO_PASSWORD are legacy settings and no longer log users in.

# -----------------------------------------------------------------------------
# 7. Service addresses -- browser-independent backend HTTP connections
# -----------------------------------------------------------------------------
# Biuro listening port. If changed, adjust all URLs that point at Biuro too.
BIURO_PORT=8081
# Email-service listening port. If changed, adjust EMAIL_SERVICE_URL below too.
EMAIL_SERVICE_PORT=8082
# Biuro -> Registration base URL. Registration currently listens on 8080 by default.
REGISTRATION_API_URL='http://localhost:8080'
# Registration -> Biuro internal catalogue base URL (no /internal/turnuses suffix).
BIURO_TURNUS_URL='http://localhost:8081'
# Registration -> email-service base URL (no /api/email/send suffix).
EMAIL_SERVICE_URL='http://localhost:8082'
# Registration -> email-service HTTP connection/read waits, ISO-8601 durations.
# Positive values of at least 1ms; no automatic retries after timeout.
# Defaults leave 25s headroom inside Biuro's 60s upstream read wait.
# If increasing them, review all enclosing proxy/client deadlines together.
EMAIL_CONNECT_TIMEOUT='PT5S'
EMAIL_READ_TIMEOUT='PT30S'
# localhost works for local JVMs; containers need appropriate service/network URLs.

# -----------------------------------------------------------------------------
# 8. Turnus catalogue refresh -- registration-api only, optional tuning
# -----------------------------------------------------------------------------
# ISO-8601 duration: maximum connection establishment time for catalogue requests.
TURNUS_CONNECT_TIMEOUT='PT15S'
# ISO-8601 duration: maximum read wait for catalogue responses.
TURNUS_READ_TIMEOUT='PT30S'
# Scheduler/check interval; also permits recovery when no catalogue was loaded.
# This is NOT the normal successful-catalogue refresh interval.
TURNUS_RETRY_INTERVAL='PT30S'
# Normal successful-catalogue refresh interval: one hour. Last good cache survives
# lookup failures in memory; it is not persisted across Registration restarts.
TURNUS_REFRESH_INTERVAL='PT1H'
# Optional Biuro seasonal role/certificate resource directory; keep packaged data.
STAFF_CATALOGUE_LOCATION='classpath:staff-seasons/'

# -----------------------------------------------------------------------------
# 9. SMTP -- email-service only
# -----------------------------------------------------------------------------
# Non-secret branding/contact settings used by email templates. These default
# to the current organizer details; override them for another environment.
EMAIL_REGULATIONS_URL='https://rekolekcje.scj.pl/informacje-organizacyjne/'
EMAIL_INFO_URL='https://rekolekcje.scj.pl/informacje-organizacyjne/'
EMAIL_CONTACT_EMAIL='zgloszenia.rek@scj.pl'
EMAIL_CONTACT_PHONE='+48 602 439 696'
EMAIL_LOGO_URL='https://rekolekcje.scj.pl/beta/wp-content/uploads/logo3.png'
# Supplied outgoing mail host. POP/IMAP is not used by this application.
MAIL_HOST='mail.watroba.com.pl'
# Supplied SMTP port. STARTTLS is assumed for 587; confirm with the provider.
MAIL_PORT=587
# SMTP authentication login. Exact variable name is MAIL_USER, not MAIL_USERNAME.
MAIL_USER='srm@watroba.com.pl'
# REQUIRED for real SMTP: mailbox/app password from the provider, supplied privately.
# Do not paste it into chat or this template.
MAIL_PASSWORD=''
# Outgoing From address; must be permitted by the SMTP provider.
MAIL_FROM='srm@watroba.com.pl'
# Authenticate to the SMTP server with MAIL_USER and MAIL_PASSWORD.
MAIL_SMTP_AUTH=true
# Upgrade the connection using STARTTLS; this is not implicit TLS on port 465.
MAIL_STARTTLS=true
# Positive millisecond limits for SMTP socket operations (not an overall deadline).
MAIL_CONNECT_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000
# Deliberately disabled in the draft. Set true in the private file ONLY when ready
# to send real emails to controlled recipients. False skips actual SMTP sending.
# Disabled sending returns success=false. A successful send means SMTP accepted
# the message, not inbox delivery. Timeouts/server failures may be unconfirmed;
# inspect logs and controlled mailbox receipt before any deliberate resend.
MAIL_ENABLED=false
# Accepted participant and minor-staff emails use these configurable card URLs.
# The current adult/minor destinations are the same PDF; separate them as needed.
PARTICIPANT_CARD_ADULT_URL='https://rekolekcje.scj.pl/beta/wp-content/uploads/karta2020.pdf'
PARTICIPANT_CARD_MINOR_URL='https://rekolekcje.scj.pl/beta/wp-content/uploads/karta2020.pdf'
# Participant acceptance email payment instructions. Leave blank until confirmed;
# when both are set, the email shows them. Example amount format: 500 zł.
PARTICIPANT_BANK_ACCOUNT=''
PARTICIPANT_DEPOSIT_AMOUNT=''
# Local MailHog alternative: MAIL_HOST=localhost, MAIL_PORT=1025,
# MAIL_SMTP_AUTH=false, MAIL_STARTTLS=false, MAIL_ENABLED=true (no SMTP credentials).
# Configuration declares this organizer-email value, but current notification
# code does not consume it; it does not set recipients, From, or Reply-To.
ORGANIZER_EMAIL=''

# -----------------------------------------------------------------------------
# 10. Browser configuration -- public values ONLY
# -----------------------------------------------------------------------------
# Biuro frontend API base URL, read by Vite during dev/build. Changing an already
# built deployment requires rebuilding the frontend. Backend CORS must also allow
# the frontend origin (currently localhost:5174); this does not configure CORS.
VITE_API_BASE_URL='http://localhost:8081'
# Only this public value belongs in frontend env/build configuration. NEVER prefix
# credentials with VITE_: Vite exposes such variables to browser code.
# Registration frontend still uses hardcoded localhost:8080 URLs; it does not
# currently read VITE_API_BASE_URL. This template does not change that code.
